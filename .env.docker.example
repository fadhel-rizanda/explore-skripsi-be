APP_FRONTEND_URL=http://localhost:3000

APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database - Menggunakan service name 'db' dari docker-compose
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=explore_skripsi
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_QUEUE=default

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3

# Cache, Session, Queue menggunakan Redis
CACHE_STORE=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

# Redis - Menggunakan service name 'redis' dari docker-compose
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="exploreSkripsi@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_EMAIL=admin@example.com

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# Google OAuth - Sesuaikan callback URL dengan domain Docker
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Reverb - Menggunakan service name 'reverb' dari docker-compose
REVERB_APP_ID=121744
REVERB_APP_KEY=nefpkqjc8inuxy43qhia
REVERB_APP_SECRET=hspndtt4savpo4tttobo
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="8080"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# FrankenPHP/Octane Configuration
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
FRANKENPHP_CONFIG="worker ./public/index.php"
NUM_THREADS=4

BROADCAST_DRIVER=reverb
